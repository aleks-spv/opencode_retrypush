{
  "name": "opencode-retry-now-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenCode plugin that adds a /retry-now command to immediately retry rate-limited requests",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "retry",
    "rate limit"
  ],
  "author": "aleks-spv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleks-spv/opencode_retrypush.git"
  },
  "files": [
    "dist",
    "commands"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.34",
    "@opencode-ai/sdk": "^1.18.34",
    "@opencode/client": "2.0.21",
    "@opencode/plugin": "2.0.21",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.7",
    "@opencode/plugin": ">=2.0.21"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "directories": {
    "test": "test"
  },
  "bugs": {
    "url": "https://github.com/aleks-spv/opencode_retrypush/issues"
  },
  "homepage": "https://github.com/aleks-spv/opencode_retrypush#readme"
}
